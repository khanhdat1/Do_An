{
  "name": "@pczone/crawler",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Thu thập dữ liệu sản phẩm tham khảo và ảnh chính hãng cho PCZone.",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx src/index.ts",
    "crawl": "dotenv -e ../../.env -- tsx src/index.ts crawl",
    "single": "dotenv -e ../../.env -- tsx src/index.ts single",
    "sync-images": "dotenv -e ../../.env -- tsx src/images/sync.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@pczone/db": "*",
    "axios": "^1.12.2",
    "cheerio": "^1.1.2",
    "dotenv": "^17.2.2",
    "p-limit": "^7.1.1",
    "sharp": "^0.35.4",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "dotenv-cli": "^10.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
