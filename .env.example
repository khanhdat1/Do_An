# =============================================================================
# PCZone – biến môi trường dùng chung cho cả monorepo
# Copy file này thành .env rồi sửa giá trị thật.
# =============================================================================

# --- Cơ sở dữ liệu (khớp với docker-compose.yml) -----------------------------
DATABASE_URL="mysql://root:root@localhost:3306/pczone"

# --- API (apps/api) ----------------------------------------------------------
API_PORT=4000
# Origin của web, dùng cho CORS. Nhiều origin thì ngăn cách bằng dấu phẩy.
CORS_ORIGIN="http://localhost:3000"
# Khoá ký JWT (tối thiểu 32 ký tự). KHÔNG dùng lại giá trị mẫu, tự sinh bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Đổi khoá này thì mọi access token đang lưu hành mất hiệu lực (người dùng tự
# đăng nhập lại bằng refresh token, không bị đăng xuất).
JWT_SECRET="thay-bang-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu"

# --- Đăng nhập bằng Google / Facebook (tuỳ chọn) ------------------------------
# Để trống thì nút tương ứng báo "chưa được cấu hình"; các chức năng khác không bị ảnh hưởng.
# Cách lấy khoá và địa chỉ callback phải khai bên Google / Facebook: README mục 8.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
# URL công khai của API (dựng địa chỉ callback gửi cho Google / Facebook, phải khớp địa chỉ đã khai)
# và của web (nơi trình duyệt quay về sau khi đăng nhập).
API_PUBLIC_URL="http://localhost:4000"
WEB_URL="http://localhost:3000"

# --- Web (apps/web) ----------------------------------------------------------
# URL API mà trình duyệt gọi
NEXT_PUBLIC_API_URL="http://localhost:4000"
# URL API mà Server Component gọi (thường giống trên; khi chạy Docker thì đổi
# thành tên service, ví dụ http://api:4000)
API_URL="http://localhost:4000"

# --- Crawler (apps/crawler) --------------------------------------------------
CRAWL_DELAY_MS=1500
CRAWL_CONCURRENCY=2
MAX_PRODUCTS_PER_CATEGORY=30
IMAGE_STORAGE_DIR=apps/web/public/images/products
IMAGE_PUBLIC_BASE=/images/products
