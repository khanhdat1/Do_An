# =============================================================================
# PCZone – biến môi trường dùng chung cho cả monorepo
# Copy file này thành .env rồi sửa giá trị thật.
# =============================================================================

# --- Cơ sở dữ liệu (khớp với docker-compose.yml) -----------------------------
DATABASE_URL="mysql://root:root@localhost:3306/pczone"

# --- API (apps/api) ----------------------------------------------------------
API_PORT=4000
# Origin của web, dùng cho CORS. Nhiều origin thì ngăn cách bằng dấu phẩy.
CORS_ORIGIN="http://localhost:3000"
# Khoá ký JWT (tối thiểu 32 ký tự). KHÔNG dùng lại giá trị mẫu, tự sinh bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Đổi khoá này thì mọi access token đang lưu hành mất hiệu lực (người dùng tự
# đăng nhập lại bằng refresh token, không bị đăng xuất).
JWT_SECRET="thay-bang-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu"

# --- Đăng nhập bằng Google / Facebook (tuỳ chọn) ------------------------------
# Để trống thì nút tương ứng báo "chưa được cấu hình"; các chức năng khác không bị ảnh hưởng.
# Cách lấy khoá và địa chỉ callback phải khai bên Google / Facebook: README mục 8.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
# URL công khai của API (dựng địa chỉ callback gửi cho Google / Facebook, phải khớp địa chỉ đã khai)
# và của web (nơi trình duyệt quay về sau khi đăng nhập).
API_PUBLIC_URL="http://localhost:4000"
WEB_URL="http://localhost:3000"

# --- Thanh toán VNPay Sandbox (tuỳ chọn) -------------------------------------
# Để trống thì phương thức VNPay ẩn ở trang đặt hàng, chỉ còn COD — các chức năng khác không bị ảnh
# hưởng. Đăng ký tài khoản thử nghiệm MIỄN PHÍ tại https://sandbox.vnpayment.vn để lấy hai khoá này
# (README mục 9). VNPAY_RETURN_URL để trống thì tự suy ra từ API_PUBLIC_URL ở trên.
VNPAY_TMN_CODE=""
VNPAY_HASH_SECRET=""
VNPAY_PAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNPAY_RETURN_URL=""

# --- Chuyển khoản ngân hàng thủ công (tuỳ chọn) -------------------------------
# Không phải cổng thanh toán — chỉ hiện mã QR VietQR (tự điền đúng số tiền + mã đơn) để khách
# chuyển khoản, sau đó NHÂN VIÊN (tài khoản role ADMIN/STAFF) vào /quan-tri/don-hang xác nhận tay.
# Để trống thì phương thức này ẩn ở trang đặt hàng. BANK_ID là BIN hoặc mã ngân hàng theo VietQR
# (vd Vietcombank "970436", Techcombank "970407" — tra đủ tại https://vietqr.io).
BANK_ID=""
BANK_ACCOUNT_NUMBER=""
BANK_ACCOUNT_NAME=""
BANK_NAME=""

# --- Chuyển khoản qua ví MoMo thủ công (tuỳ chọn) -----------------------------
# Cùng nguyên tắc với chuyển khoản ngân hàng ở trên: hiện số điện thoại để khách tự chuyển trong
# app MoMo, không phải tích hợp API MoMo Business (cần đăng ký merchant riêng, không dùng ở đây).
MOMO_PHONE=""
MOMO_DISPLAY_NAME=""

# --- Gửi email "quên mật khẩu" qua Resend (tuỳ chọn) --------------------------
# Để trống thì link đặt lại mật khẩu chỉ in ra console của server thay vì gửi email thật — tính
# năng vẫn kiểm thử được, chỉ không có email thật. Đăng ký tài khoản MIỄN PHÍ (100 email/ngày,
# không cần thẻ) tại https://resend.com để lấy API key. Chưa xác minh tên miền riêng thì Resend chỉ
# gửi được tới đúng email bạn dùng đăng ký Resend — đủ dùng để tự kiểm thử đồ án.
RESEND_API_KEY=""
EMAIL_FROM="PCZone <onboarding@resend.dev>"

# --- AI Search / AI Chat / AI Build PC (tuỳ chọn) -----------------------------
# Để trống thì nút "AI Search" tự lùi về đúng tìm kiếm từ khoá đã có, không báo lỗi.
#
# Dự án dùng gói `openai` (chuẩn "OpenAI-compatible") nên dùng được với nhiều hãng, không chỉ OpenAI
# thật — mặc định dưới đây trỏ vào GEMINI (Google AI Studio) vì có gói MIỄN PHÍ thật, không cần thẻ:
# đăng ký tại https://aistudio.google.com bằng tài khoản Google có sẵn, lấy API key ở mục "Get API
# key", KHÔNG cần đăng ký gì thêm ở OPENAI_BASE_URL đã điền sẵn bên dưới.
#
# Muốn dùng OpenAI thật thay vì Gemini: xoá trống OPENAI_BASE_URL (để trống thì gói `openai` tự dùng
# địa chỉ thật của OpenAI), điền khoá lấy từ https://platform.openai.com (cần thẻ/nạp tiền, khác
# Gemini), đổi lại hai tên model bên dưới cho hợp OpenAI (xem README mục "Tìm kiếm bằng AI").
#
# Dù dùng hãng nào, tên model cũng đổi khá nhanh — nên xác nhận lại tên đang thật sự dùng được trên
# tài khoản của bạn trước khi test thật, đừng chỉ tin mặc định dưới đây.
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
OPENAI_CHAT_MODEL="gemini-3.1-flash-lite"
OPENAI_EMBEDDING_MODEL="gemini-embedding-2-preview"

# --- Web (apps/web) ----------------------------------------------------------
# URL API mà trình duyệt gọi
NEXT_PUBLIC_API_URL="http://localhost:4000"
# URL API mà Server Component gọi (thường giống trên; khi chạy Docker thì đổi
# thành tên service, ví dụ http://api:4000)
API_URL="http://localhost:4000"

# --- Crawler (apps/crawler) --------------------------------------------------
CRAWL_DELAY_MS=1500
CRAWL_CONCURRENCY=2
MAX_PRODUCTS_PER_CATEGORY=30
IMAGE_STORAGE_DIR=apps/web/public/images/products
IMAGE_PUBLIC_BASE=/images/products
