# Cấu hình triển khai PCZone (README mục 14). Trên máy chủ: cp .env.example .env rồi điền.
# deploy/.env chứa bí mật — KHÔNG commit (đã có trong .gitignore), không gửi qua chat/email.
# Sinh chuỗi ngẫu nhiên:  openssl rand -hex 32

# ---------------------------------------------------------------------------------------------------------------
# Địa chỉ trang
# ---------------------------------------------------------------------------------------------------------------
# Tên miền đã trỏ (bản ghi A) về IP máy chủ — Caddy tự xin và gia hạn chứng chỉ HTTPS cho đúng địa chỉ này.
# Chưa có tên miền: dùng <IP viết bằng gạch ngang>.sslip.io, vd 203-0-113-5.sslip.io (tự trỏ về IP đó).
SITE_ADDRESS=pczone.example.com
# Địa chỉ đầy đủ khách truy cập — dùng cho CORS, cookie đăng nhập, link quay về của Google/Facebook/VNPay
PUBLIC_URL=https://pczone.example.com

# ---------------------------------------------------------------------------------------------------------------
# Cơ sở dữ liệu — MySQL chỉ chạy trong mạng Docker, không mở ra Internet. CHỈ dùng chữ và số (mật khẩu được ghép
# thẳng vào DATABASE_URL): openssl rand -hex 24
# ---------------------------------------------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# ---------------------------------------------------------------------------------------------------------------
# Bắt buộc: khoá ký phiên đăng nhập (tối thiểu 32 ký tự) — openssl rand -hex 32
# ---------------------------------------------------------------------------------------------------------------
JWT_SECRET=

# ---------------------------------------------------------------------------------------------------------------
# Tuỳ chọn — để trống thì tính năng tương ứng tự báo "chưa cấu hình", phần còn lại vẫn chạy
# ---------------------------------------------------------------------------------------------------------------
# Đăng nhập Google / Facebook (README mục 8) — nhớ khai thêm địa chỉ callback trên tên miền thật:
#   <PUBLIC_URL>/api/auth/google/callback   và   <PUBLIC_URL>/api/auth/facebook/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# VNPay (README mục 9). Link quay về tự lấy theo PUBLIC_URL; địa chỉ IPN khai ở trang quản lý của VNPay:
#   <PUBLIC_URL>/api/payments/vnpay/ipn
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# Mặc định cổng sandbox; khi có hợp đồng VNPay thật thì đổi sang địa chỉ cổng thật VNPay cấp
# VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# Chuyển khoản ngân hàng / MoMo thủ công (README mục 9) — thông tin này hiện công khai cho khách ở trang thanh toán
BANK_ID=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_NAME=
BANK_NAME=
MOMO_PHONE=
MOMO_DISPLAY_NAME=

# Email quên mật khẩu / xác minh email qua Resend (README mục 8). Người gửi mặc định onboarding@resend.dev chỉ gửi
# được tới chính email chủ tài khoản Resend — gửi cho khách thật cần xác minh tên miền trên Resend rồi đổi EMAIL_FROM
RESEND_API_KEY=
# EMAIL_FROM=PCZone <no-reply@ten-mien-cua-ban>

# AI Search / AI Chat / AI gợi ý cấu hình (README mục "Tìm kiếm bằng AI"). Trang công khai thì ai cũng dùng được,
# tốn lượt gọi AI của khoá này — có thể tạm tắt từng tính năng ở /admin/settings
OPENAI_API_KEY=
OPENAI_BASE_URL=
# OPENAI_CHAT_MODEL=gemini-3.1-flash-lite
# OPENAI_EMBEDDING_MODEL=gemini-embedding-2-preview

# ---------------------------------------------------------------------------------------------------------------
# Chỉ dùng khi chạy thử cả cụm trên máy dev (máy chủ thật để mặc định)
# ---------------------------------------------------------------------------------------------------------------
# HTTP_PORT=80
# HTTPS_PORT=443
# PRODUCT_IMAGE_DIR=./data/products
# BANNER_DIR=./data/banners
