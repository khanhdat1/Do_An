# Cổng vào duy nhất của PCZone: HTTPS tự động (Let's Encrypt) cho SITE_ADDRESS trong deploy/.env, rồi chia đường:
#   /api/*             → API (không vòng qua proxy của Next)
#   /images/banners/*  → đọc thẳng ổ lưu trữ chung: banner quản trị tải lên LÚC ĐANG CHẠY, mà `next start` chỉ phục vụ
#                        file có sẵn lúc khởi động (apps/web/lib/uploaded-images.ts)
#   còn lại            → web (Next.js)
{$SITE_ADDRESS} {
	encode zstd gzip

	# HSTS: trình duyệt đã vào qua HTTPS thì từ đó luôn dùng HTTPS (bỏ qua khi chạy thử HTTP trên máy dev); nosniff cho
	# cả file banner Caddy tự phục vụ; bỏ header "Server". Header bảo mật của trang web đặt ở apps/web/next.config.ts
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}

	handle /api/* {
		reverse_proxy api:4000
	}

	handle /images/banners/* {
		root * /srv/public
		file_server
	}

	handle {
		reverse_proxy web:3000
	}
}
